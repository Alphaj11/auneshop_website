# -----------------------------------------------------------------------------
# Aune — variables d'environnement
# Copier ce fichier en `.env` (développement) ou les définir chez l'hébergeur.
# Ne JAMAIS committer de vraies valeurs. Aucune de ces variables n'est envoyée
# au navigateur (aucune n'est préfixée NEXT_PUBLIC_).
# -----------------------------------------------------------------------------

# Base PostgreSQL (16 ou plus)
DATABASE_URL=postgresql://aune:mot-de-passe@localhost:5432/auneshop
# Connexions simultanées par instance (facultatif, 10 par défaut)
# DATABASE_POOL_SIZE=10

# URL publique du site, sans barre finale (liens des emails, Stripe, sitemap)
APP_URL=http://localhost:3000

# Secret de signature (jetons d'accès aux commandes invitées). 32 caractères minimum.
# Générer : openssl rand -hex 32
SESSION_SECRET=

# Paiement : "demo" (aucun paiement réel) ou "stripe"
PAYMENT_MODE=demo
# En production, le mode démo est bloqué (aucune commande possible) sauf si :
# ALLOW_DEMO_CHECKOUT=true   (site de présentation uniquement)
# Clé secrète Stripe (sk_test_… en test, sk_live_… en production). Serveur uniquement.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), fourni par Stripe pour l'URL /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Stockage des images : "local" (dossier UPLOAD_DIR) ou "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=storage/uploads
# Stockage compatible S3 (AWS, Scaleway, OVH, Cloudflare R2…), si STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Emails transactionnels (Brevo, Postmark, Mailjet, OVH…). Vide = emails affichés dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Aune <commandes@auneshop.fr>"
# Qamar (admin) : adresse des concepteurs du site, prévenus à chaque demande (seulement si SMTP_HOST est réglé)
DESIGNERS_EMAIL=

# Secret de la tâche planifiée /api/cron/expire-orders (en-tête Authorization: Bearer …)
CRON_SECRET=

# Mot de passe du compte client de démonstration créé par le seed (développement uniquement)
DEMO_PASSWORD=

# Tests de bout en bout (facultatif)
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=admin@exemple.test
# E2E_ADMIN_PASSWORD=
# PW_CHROMIUM_PATH=
